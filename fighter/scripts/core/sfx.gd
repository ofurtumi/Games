extends Node
## Autoload `Sfx`: pooled sound effects + music. Sounds are WAVs in res://assets/sfx/ generated by
## `python3 tools/gen_sfx.py`.
##
##   Sfx.play("punch", fighter.center())     # positional (world Vector2)
##   Sfx.play("ui_select")                   # non-positional (UI)
##   Sfx.play(Sfx.gun_sound(def.id, def), muzzle)
##   Sfx.music(true)
##
## Identical sounds are rate-limited (minigun, shotgun pellets, explosion chains) and missing names
## warn once. Works with the dummy audio driver under --headless.

const DIR := "res://assets/sfx/"
const VOICES_2D := 24
const VOICES_UI := 6
const MAX_DISTANCE := 950.0 # world px; maps are up to ~1300 px wide
const ATTENUATION := 0.7 # <1 = gentle falloff: off-screen fights quieter but audible
const RATE_WINDOW_MS := 30
const RATE_MAX := 3 # same sound more than this many times inside the window is dropped
const MUSIC_DB := -14.0

## Weapon id (data/items/*.json) -> shot sound. Unknown ids fall back to a guess from the def.
const GUN_SOUNDS := {
	"pistol": "pistol",
	"derringer": "magnum",
	"assault": "rifle",
	"minigun": "minigun",
	"shotgun": "shotgun",
	"blunderbuss": "shotgun",
	"bfg": "laser",
	"sling": "throw",
}

var master_db := 0.0:
	set(v):
		master_db = v
		AudioServer.set_bus_volume_db(0, v)
var muted := false:
	set(v):
		muted = v
		AudioServer.set_bus_mute(0, v)

var _streams := {} # sound -> AudioStream (or null when missing)
var _warned := {}
var _recent := {} # sound -> PackedInt64Array of recent play times (ms)
var _pool_2d: Array[AudioStreamPlayer2D] = []
var _pool_ui: Array[AudioStreamPlayer] = []
var _started_2d := PackedInt64Array()
var _next_ui := 0
var _music: AudioStreamPlayer
var _listener: AudioListener2D
var _sfx_bus := "Master"
var _music_bus := "Master"


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_sfx_bus = _ensure_bus("SFX")
	_music_bus = _ensure_bus("Music")
	for i in VOICES_2D:
		var p := AudioStreamPlayer2D.new()
		p.bus = _sfx_bus
		p.max_distance = MAX_DISTANCE
		p.attenuation = ATTENUATION
		p.panning_strength = 0.6
		add_child(p)
		_pool_2d.append(p)
		_started_2d.append(0)
	for i in VOICES_UI:
		var p := AudioStreamPlayer.new()
		p.bus = _sfx_bus
		add_child(p)
		_pool_ui.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = _music_bus
	_music.volume_db = MUSIC_DB
	add_child(_music)
	# Our own listener follows whatever Camera2D is active, so distance is measured from the
	# middle of the screen no matter how the camera pans/zooms.
	_listener = AudioListener2D.new()
	add_child(_listener)
	_listener.make_current()


func _process(_dt: float) -> void:
	var cam := get_viewport().get_camera_2d()
	if cam:
		_listener.global_position = cam.get_screen_center_position()


func _ensure_bus(nm: String) -> String:
	if AudioServer.get_bus_index(nm) < 0:
		AudioServer.add_bus()
		var i := AudioServer.bus_count - 1
		AudioServer.set_bus_name(i, nm)
		AudioServer.set_bus_send(i, "Master")
	return nm


## Plays `sound` (file name in assets/sfx without .wav). `pos`: world Vector2 for a positional
## sound, null for UI. `pitch_var`: random pitch jitter (+/- fraction).
func play(sound: String, pos: Variant = null, vol_db := 0.0, pitch_var := 0.08) -> void:
	if sound == "":
		return
	var stream := _stream(sound)
	if stream == null or not _rate_ok(sound):
		return
	var pitch := 1.0 + randf_range(-pitch_var, pitch_var) if pitch_var > 0.0 else 1.0
	if pos is Vector2:
		var i := _voice_2d()
		var p := _pool_2d[i]
		_started_2d[i] = Time.get_ticks_msec()
		p.stop()
		p.stream = stream
		p.global_position = pos
		p.volume_db = vol_db
		p.pitch_scale = pitch
		p.play()
	else:
		var p := _pool_ui[_next_ui]
		_next_ui = (_next_ui + 1) % _pool_ui.size()
		p.stop()
		p.stream = stream
		p.volume_db = vol_db
		p.pitch_scale = pitch
		p.play()


## Shot sound for a gun. `def` (WeaponDef, optional) lets unknown/modded guns pick a fitting one.
func gun_sound(weapon_id: String, def: Variant = null) -> String:
	if GUN_SOUNDS.has(weapon_id):
		return GUN_SOUNDS[weapon_id]
	if def is WeaponDef:
		var d: WeaponDef = def
		if d.charge_time > 0.0 and d.bullet_size >= 2.5:
			return "laser"
		if d.pellets > 1:
			return "shotgun"
		if d.auto:
			return "minigun" if d.fire_rate < 0.06 else ("rifle" if d.damage >= 9.0 else "smg")
		if d.damage >= 60.0 or d.pierce > 0:
			return "sniper"
		if d.damage >= 35.0:
			return "magnum"
	return "pistol"


func music(on: bool) -> void:
	if not on:
		_music.stop()
		return
	if _music.playing:
		return
	var s := _stream("music_loop")
	if s == null:
		return
	if s is AudioStreamWAV and (s as AudioStreamWAV).loop_mode == AudioStreamWAV.LOOP_DISABLED:
		# The .import file sets loop_mode=Forward; this is the fallback if it gets reset.
		var w := s as AudioStreamWAV
		w.loop_begin = 0
		w.loop_end = int(w.get_length() * w.mix_rate)
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
	_music.stream = s
	_music.play()


func toggle_mute() -> void:
	muted = not muted


func _stream(sound: String) -> AudioStream:
	if _streams.has(sound):
		return _streams[sound]
	var path := DIR + sound + ".wav"
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path) as AudioStream
	if s == null and not _warned.has(sound):
		_warned[sound] = true
		push_warning("Sfx: missing sound '%s' (%s)" % [sound, path])
	_streams[sound] = s
	return s


func _rate_ok(sound: String) -> bool:
	var now := Time.get_ticks_msec()
	var times: PackedInt64Array = _recent.get(sound, PackedInt64Array())
	var kept := PackedInt64Array()
	for t in times:
		if now - t < RATE_WINDOW_MS:
			kept.append(t)
	if kept.size() >= RATE_MAX:
		_recent[sound] = kept
		return false
	kept.append(now)
	_recent[sound] = kept
	return true


## A free 2D voice, or the one that started longest ago.
func _voice_2d() -> int:
	var oldest := 0
	for i in _pool_2d.size():
		if not _pool_2d[i].playing:
			return i
		if _started_2d[i] < _started_2d[oldest]:
			oldest = i
	return oldest
