# ---------------------------------------------------------------- countdown

# 3 . 2 . 1 . GO: everyone is held on the line until GO.
func start_countdown() -> void:
	countdown = 3.6
	_count_shown = -1
	lap_time = 0.0
	race_time = 0.0
	ship.set_process(false)
	for rv in rivals:
		rv.set_process(false)

func _tick_countdown(delta: float) -> void:
	countdown -= delta
	var n = maxi(ceili(countdown - 0.6), 0)
	if n != _count_shown:
		_count_shown = n
		overlay.show_count(n)
		Sfx.play("ui_select" if n == 0 else "tick", 2.0, 1.6 if n == 0 else 1.0)
	if n == 0:
		countdown = 0.0
		ship.set_process(not garage)
		for rv in rivals:
			rv.set_process(true)

func close_menu() -> void:
	menu.hide_menu()
	ship.set_process(not garage)

func _toggle_res() -> void:
	var vp = get_viewport()
	vp.scaling_3d_scale = 1.0 if vp.scaling_3d_scale < 1.0 else 0.5

func _next_planet() -> void:
	race_laps = 0
	for rv in rivals:
		rv.queue_free()
	rivals.clear()
	planet_index += 1
	track_seed = rng.randi() % 100000
	_new_planet()

func open_garage() -> void:
	if mode == "mining":
		ship.visible = true
		cam.current = true
	_set_garage(true)
	grid_garage.open(self)

func garage_closed() -> void:
	_set_garage(false)
	save_game()
	if mode == "mining":
		ship.visible = false
		ship.set_process(false)
		mining.garage_closed()

# ---------------------------------------------------------------- modes

func enter_mining() -> void:
	if mode == "mining":
		return
	mode = "mining"
	race_laps = 0
	for rv in rivals:
		rv.queue_free()
	rivals.clear()
	for n in [terrain, track, ship, hud]:
		n.visible = false
	ship.set_process(false)
	for pk in pickups:
		pk.node.queue_free()
	pickups.clear()
	mining = MiningScript.new()
	mining.name = "Mining"
	add_child(mining)
	mining.setup(self)

# From an outpost: that planet's own track, three laps against the locals.
func race_on(palette: int) -> void:
	leave_mining()
	planet_index = palette
	track_seed = 500 + palette * 37
	_new_planet()
	race_laps = 3
	race_origin = "expedition"
	_spawn_rivals(palette)
	start_countdown()

func _rival_loadout(spec: Array) -> Dictionary:
	var lo = _rival_base(spec)
	for tool in spec[2]:
		fit(lo, {"id": tool[0], "cell": Vector2i.ZERO, "rot": 0, "cards": tool[1]})
	return lo

# Put a part on a ship wherever it goes (nose parts as far forward as they
# can, the rest from the back, any way round). Ships are usually full, so
# spare bits come off to make room, the drill last (a nose tool takes its
# place; rivals without one hop barriers or laser through them).
const SPARE = ["plate", "magnet", "magnet_2", "emitter", "tank", "fin", "hopjet", "brake", "brake_2", "charges", "drill_1", "drill_2", "drill_3"]

static func fit(lo: Dictionary, part: Dictionary) -> bool:
	if _fit_spot(lo.frame, lo.parts, part):
		return true
	# Taking off just one spare bit is enough more often than not.
	for id in SPARE:
		for i in lo.parts.size():
			if lo.parts[i].id == id:
				var less = lo.parts.duplicate(true)
				less.remove_at(i)
				if _fit_spot(lo.frame, less, part):
					lo.parts = less
					return true
	# Otherwise strip spares in order until it goes.
	var less = lo.parts.duplicate(true)
	for id in SPARE:
		var i = 0
		while i < less.size():
			if less[i].id == id:
				less.remove_at(i)
				if _fit_spot(lo.frame, less, part):
					lo.parts = less
					return true
			else:
				i += 1
	return false    # no room even stripped down: the build is left alone

static func _fit_spot(frame: String, parts: Array, part: Dictionary) -> bool:
	var size = Parts.frame_size(frame)
	var nose = Parts.PARTS[part.id].get("nose", false)
	var ys = range(size.y) if nose else range(size.y - 1, -1, -1)
	for y in ys:
		for x in size.x:
			for rot in ([0] if nose else [0, 1, 2, 3]):
				var p = part.duplicate(true)
				p.cell = Vector2i(x, y)
				p.rot = rot
				if Parts.can_place(frame, parts, p):
					parts.append(p)
					return true
	return false

func _rival_base(spec: Array) -> Dictionary:
	if spec[0] == "Basalt":
		# Lava planet locals: armour everywhere, not much go.
		return {"name": "Basalt", "frame": "advanced", "paint": {"primary": spec[3], "secondary": Color(1.0, 0.45, 0.1), "pattern": "twin"},
			"parts": [{"id": "engine_1", "cell": Vector2i(4, 4), "rot": 0}, {"id": "burner", "cell": Vector2i(0, 9), "rot": 0}, {"id": "burner", "cell": Vector2i(8, 9), "rot": 0},
				{"id": "plate", "cell": Vector2i(0, 8), "rot": 0}, {"id": "plate", "cell": Vector2i(8, 8), "rot": 0}, {"id": "plate", "cell": Vector2i(2, 3), "rot": 0},
				{"id": "plate", "cell": Vector2i(6, 3), "rot": 0}, {"id": "shield", "cell": Vector2i(4, 0), "rot": 0}, {"id": "shield", "cell": Vector2i(5, 0), "rot": 0},
				{"id": "emitter", "cell": Vector2i(3, 7), "rot": 0}]}
	for p in Parts.presets():
		if p.name == spec[0]:
			var lo = p.duplicate(true)
			lo.paint.primary = spec[3]
			return lo
	return Parts.presets()[0]

func _spawn_rivals(palette: int) -> void:
	for rv in rivals:
		rv.queue_free()
	rivals.clear()
	var cp = track.checkpoints[0]
	var side = Vector3(cp.dir.z, 0.0, -cp.dir.x)
	var k = 0
	for spec in RIVALS.get(palette, RIVALS[0]):
		var rv = ShipScript.new()
		rv.rival = true
		rv.pilot = PILOTS[(palette * 3 + k) % PILOTS.size()]
		add_child(rv)
		rv.setup(terrain, track, fx, self)
		rv.equip(_rival_loadout(spec))
		rv.aggro = spec[4]
		rv.autopilot = true
		k += 1
		var lane = -1.0 if k % 2 == 1 else 1.0
		rv.place(cp.pos - cp.dir * (3.0 + 4.0 * k) + side * lane * minf(track.hw[cp.idx] * 0.5, 2.5), atan2(cp.dir.x, cp.dir.z))
		rv.progress_idx = cp.idx
		rivals.append(rv)
	ship.distance = 0.0
	ship.finish_time = -1.0
	race_over = 0.0

func rival_destroyed(rv) -> void:
	if rv.down_left > 0.0:
		return
	shatter(rv.model, Vector3.UP, rv.vel, 18.0)
	_slowmo_left = 0.0
	Engine.time_scale = 1.0
	shake = 0.4
	rv.model.visible = false
	rv.set_process(false)
	rv.down_left = 2.2

# Standings: who has covered the most track.
func place_of(who) -> int:
	var p = 1
	for rv in rivals:
		if rv != who and rv.distance > who.distance:
			p += 1
	if who != ship and ship.distance > who.distance:
		p += 1
	return p

func _track_distance(s, delta_idx_from: int) -> void:
	var n = track.pts.size()
	var d = s.progress_idx - delta_idx_from
	if d > n / 2:
		d -= n
	elif d < -n / 2:
		d += n
	s.distance += d

func _race_rivals(delta: float) -> void:
	for rv in rivals:
		if rv.down_left > 0.0:
			rv.down_left -= delta
			if rv.down_left <= 0.0:
				var i = rv.progress_idx
				rv.place(track.pts[i], atan2(track.tangents[i].x, track.tangents[i].z))
				rv.model.visible = true
				rv.set_process(true)
				rv.restore()
			continue
		var before = rv.progress_idx
		rv.progress_idx = track.nearest(rv.position, rv.progress_idx)
		_track_distance(rv, before)
		# Rivals reload their tools every half lap (you do at the gates).
		if rv.distance - rv.get_meta("reloaded", 0.0) > track.pts.size() * 0.5:
			rv.set_meta("reloaded", rv.distance)
			rv.weapons.refill()
		if race_laps > 0 and rv.finish_time < 0.0 and rv.distance >= race_laps * track.pts.size() - 2:
			rv.finish_time = race_time
		# Bumping: push apart by mass, trade some speed, hurt on hard hits.
		for other in [ship] + rivals:
			if other == rv or (other == ship and _respawn_left > 0.0) or (other != ship and other.down_left > 0.0):
				continue
			var d = Vector2(rv.position.x - other.position.x, rv.position.z - other.position.z)
			var min_d = rv.stats.radius + other.stats.radius
			if d.length() < min_d and d.length() > 0.01:
				var n = d.normalized()
				var wa = 1.0 / rv.stats.mass
				var wb = 1.0 / other.stats.mass
				var push = (min_d - d.length()) / (wa + wb)
				rv.position += Vector3(n.x, 0, n.y) * push * wa
				other.position -= Vector3(n.x, 0, n.y) * push * wb
				var rel = (rv.vel - other.vel).dot(Vector3(n.x, 0, n.y))
				if rel < 0.0:
					var j = -rel * 1.4 / (wa + wb)
					rv.vel += Vector3(n.x, 0, n.y) * j * wa
					other.vel -= Vector3(n.x, 0, n.y) * j * wb
					if -rel > 8.0:
						rv.take_hit((-rel - 8.0) * 1.5)
						other.take_hit((-rel - 8.0) * 1.5)
						fx.burst((rv.position + other.position) * 0.5 + Vector3(0, 0.7, 0), Color(1.0, 0.75, 0.4), 12, 7.0, 1.2, 0.08, 0.35)

func _finish_race() -> void:
	ship.finish_time = race_time
	var place = place_of(ship)
	contract_event("race", {"planet": planet_index % 4, "place": place})
	var reward = RACE_REWARDS[mini(place - 1, RACE_REWARDS.size() - 1)]
	var bits = []
	for k in reward:
		inventory[k] = inventory.get(k, 0) + reward[k]
		bits.append("+%d %s" % [reward[k], k])
	var names = ["1ST", "2ND", "3RD", "4TH"]
	Sfx.play("lap")
	Sfx.play("coins")
	race_over = 1.0
	ship.autopilot = true
	save_game()
	show_results(names[mini(place - 1, 3)], "  ".join(bits))

# GT4-style results: everyone's place and time, the prize, what next.
func show_results(place_name: String, prize: String) -> void:
	var field = [ship] + rivals
	field.sort_custom(func(a, b):
		var fa = a.finish_time >= 0.0
		var fb = b.finish_time >= 0.0
		if fa and fb:
			return a.finish_time < b.finish_time
		if fa != fb:
			return fa
		return a.distance > b.distance)
	var rows = []
	var lead = field[0]
	for i in field.size():
		var e = field[i]
		var value = Hud.laptime(e.finish_time) if e.finish_time >= 0.0 else "+%d m" % int(lead.distance - e.distance)
		rows.append({"label": "%d    %s" % [i + 1, e.pilot], "value": value})
	rows.append({"label": "Prize", "value": prize})
	rows.append({"label": "Race again", "action": _restart_race})
	if race_origin == "expedition":
		rows.append({"label": "Expedition", "action": func(): _close_results(); enter_mining()})
	rows.append({"label": "Main menu", "action": func(): _close_results(); show_title()})
	menu.show_menu("RESULTS  ·  " + place_name, rows, Callable())
	menu.selected = field.size() + 1

# Practice results: what this run came to, against the track's medals.
func show_session() -> void:
	var best = session.get("best", -1.0)
	var rows = [
		{"label": "Laps", "value": str(session.get("laps", 0))},
		{"label": "Best lap", "value": Hud.laptime(best)},
		{"label": "Last lap", "value": Hud.laptime(last_lap if session.get("laps", 0) > 0 else -1.0)},
	]
	var won = medals_won()
	for m in MEDALS:
		var t = medal_time(m)
		var state = "NEW" if session.get("medals", []).has(m.name) else ("WON" if won.has(m.name) else
			("+%.2fs" % (best - t) if best >= 0.0 else "-"))
		rows.append({"label": m.name.capitalize(), "value": "%s   %s" % [Hud.laptime(t), state], "swatch": m.color})
	var bits = []
	for k in session.get("earned", {}):
		bits.append("+%d %s" % [session.earned[k], k])
	rows.append({"label": "Earned", "value": "  ".join(bits) if not bits.is_empty() else "-"})
	rows.append({"label": "Keep driving", "action": close_menu})
	rows.append({"label": "Restart", "action": func(): menu.hide_menu(); _reset_race(); start_countdown()})
	rows.append({"label": "Main menu", "action": func(): menu.hide_menu(); show_title()})
	var head = "NEW MEDAL" if not session.get("medals", []).is_empty() else ("BEST  " + Hud.laptime(best) if best >= 0.0 else "NO LAPS")
	menu.show_menu("PRACTICE  ·  " + head, rows, close_menu)
	menu.selected = rows.size() - 3

func _close_results() -> void:
	menu.hide_menu()
	ship.autopilot = has_meta("auto")

func _restart_race() -> void:
	_close_results()
	lap = 1
	lap_time = 0.0
	next_cp = 1
	last_cp = 0
	_respawn()
	_spawn_rivals(planet_index)
	start_countdown()

func leave_mining() -> void:
	if mode != "mining":
		return
	mining.leave()
	mining = null
	mode = "race"
	for n in [terrain, track, ship, hud]:
		n.visible = true
	cam.current = true
	ship.set_process(true)
	_respawn()
	save_game()

func _set_garage(on: bool) -> void:
	if on == garage:
		return
	garage = on
	ship.set_process(not on)
	if on:
		_saved_pose = [ship.position, ship.heading]
		ship.place(SHOWROOM, PI * 0.8)
	else:
		ship.model.rotation = Vector3.ZERO
		ship.rig.shield.visible = true
		if _saved_pose.size() > 0:
			ship.place(_saved_pose[0], _saved_pose[1])
	cam_focus = ship.position

# Blow `model` apart: every visible mesh becomes a tumbling piece, plus fire,
# a camera kick, slow motion and the red flash. `up` is the world's up for
# the pieces (they fall back down it unless gravity is 0).
func shatter(model: Node3D, up: Vector3, base_vel: Vector3, gravity: float) -> void:
	var origin = model.global_position
	var n = 0
	for mi in model.find_children("*", "MeshInstance3D", true, false):
		if not mi.is_visible_in_tree() or mi.mesh == null or n >= 70:
			continue
		if mi.material_override is ShaderMaterial:
			continue
		n += 1
		var copy = MeshInstance3D.new()
		copy.mesh = mi.mesh
		copy.material_override = mi.material_override
		add_child(copy)
		copy.global_transform = mi.global_transform
		var out = mi.global_position - origin
		out = out.normalized() if out.length() > 0.01 else Vector3(randf_range(-1, 1), randf_range(-1, 1), randf_range(-1, 1)).normalized()
		out -= up * out.dot(up) * 0.5
		pieces.append({"node": copy, "vel": base_vel * 0.4 + out * randf_range(4.0, 11.0) + up * randf_range(3.0, 8.0),
			"spin": Vector3(randf_range(-9, 9), randf_range(-9, 9), randf_range(-9, 9)), "life": randf_range(2.2, 3.5), "gravity": gravity, "up": up})
	var c = origin + up * 0.6
	fx.burst(c, Color(1.0, 0.55, 0.15), 60, 16.0, 1.5, 0.3, 0.9, gravity)
	fx.burst(c, Color(1.0, 0.9, 0.6), 30, 10.0, 2.0, 0.15, 0.5, 0.0)
	fx.burst(c, Color(0.15, 0.15, 0.15), 30, 5.0, 0.0, 0.7, 1.6, -gravity * 0.1)
	shake = 1.0
	Sfx.play("big_boom", 2.0)
	_slowmo_left = 0.9
	Engine.time_scale = 0.25

func _update_pieces(delta: float) -> void:
	var keep = []
	for p in pieces:
		p.life -= delta
		p.vel -= p.up * p.gravity * delta
		p.vel *= 1.0 - 0.4 * delta
		var n: Node3D = p.node
		n.global_position += p.vel * delta
		if p.gravity > 0.0 and n.global_position.dot(p.up) < 0.1:
			n.global_position -= p.up * (n.global_position.dot(p.up) - 0.1)
			p.vel = p.vel - p.up * p.vel.dot(p.up) * 1.4
			p.vel *= 0.6
		n.rotate_x(p.spin.x * delta)
		n.rotate_y(p.spin.y * delta)
		n.rotate_z(p.spin.z * delta)
		if p.life < 0.6:
			n.scale = Vector3.ONE * maxf(p.life / 0.6, 0.01)
		if p.life <= 0.0:
			n.queue_free()
		else:
			keep.append(p)
	pieces = keep

# Real-time bookkeeping for slow motion, shake and the death overlay.
func _real_time_tick() -> float:
	var now = Time.get_ticks_msec()
	var real_dt = clampf((now - _last_real) / 1000.0, 0.0, 0.1) if _last_real > 0 else 0.0
	_last_real = now
	if _slowmo_left > 0.0:
		_slowmo_left -= real_dt
		Engine.time_scale = lerpf(1.0, 0.25, clampf(_slowmo_left / 0.5, 0.0, 1.0))
		if _slowmo_left <= 0.0:
			Engine.time_scale = 1.0
	shake = maxf(0.0, shake - real_dt * 1.6)
	overlay.tick(real_dt)
	return real_dt

func shake_offset() -> Vector3:
	return Vector3(randf_range(-1, 1), randf_range(-1, 1), randf_range(-1, 1)) * shake * shake * 1.2

# Race: a hit with no shield left. The ship goes up, the clock keeps running,
# and you're back at the last gate a couple of seconds later.
func ship_destroyed() -> void:
	if _respawn_left > 0.0:
		return
	shatter(ship.model, Vector3.UP, ship.vel, 18.0)
	ship.model.visible = false
	ship.set_process(false)
	for tr in ship.trails:
		tr.clear_points()
	overlay.show_death("DESTROYED", "back to the last gate  ·  the clock keeps running")
	_respawn_left = 2.4

func _process(delta):
	var real_dt = _real_time_tick()
	_update_pieces(delta)
	if _respawn_left > 0.0:
		_respawn_left -= real_dt
		if _respawn_left <= 0.0:
			ship.model.visible = true
			ship.set_process(not garage and mode == "race")
			_respawn()
	delta = minf(delta, 1.0 / 30.0)
	if mode == "mining" and not garage:
		for m in messages:
			m.t -= delta
		messages = messages.filter(func(m): return m.t > 0.0)
		return
	if garage:
		ship.model.rotate_y(delta * 0.6)
		ship.model.position.y = ship.HOVER + sin(Time.get_ticks_msec() * 0.002) * 0.05
		ship.rig.shield.visible = false
		for f in ship.rig.flames:
			f.scale = Vector3(1, 1, 0.3 + randf() * 0.1)
		for sp in ship.rig.spinners:
			sp[0].rotate_object_local(sp[1], sp[2] * delta)
	elif countdown > 0.0:
		_tick_countdown(delta)
	else:
		lap_time += delta
		_race(delta)
	_update_pickups(delta)
	_update_charges(delta)
	_update_camera(delta)
	for m in messages:
		if countdown <= 0.0:
			m.t -= delta
	messages = messages.filter(func(m): return m.t > 0.0)
	hud.queue_redraw()
	if shot_path != "":
		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
		_frame += 1
		if _frame == shot_frames:
			var img = get_viewport().get_texture().get_image()
			img.save_png(shot_path)
			print("saved ", shot_path, " garage=", garage, " ship=", ship.position, " cam=", cam.position)
			get_tree().quit()

# Rival homing missiles that have locked on to you (their target is where
# you are), as world positions. The HUD points at them and it beeps.
func missile_locks() -> Array:
	var out = []
	if mode != "race" or _respawn_left > 0.0:
		return out
	var me = ship.pos2()
	for rv in rivals:
		for s in rv.weapons.shots:
			if s.prog.get("homing", false) and s.target != null and s.target.distance_to(me) < 4.0 and s.pos.distance_to(me) < 45.0:
				out.append(Vector3(s.pos.x, ship.position.y, s.pos.y))
	return out

var _lock_beep = 0.0

func _race(delta: float) -> void:
	_lock_beep -= delta
	if _lock_beep <= 0.0 and not missile_locks().is_empty():
		_lock_beep = 0.28
		Sfx.play("tick", -2.0, 1.9)
	var before = ship.progress_idx
	ship.progress_idx = track.nearest(ship.position, ship.progress_idx)
	_track_distance(ship, before)
	_race_rivals(delta)
	if race_laps > 0 and race_over <= 0.0:
		race_time += delta
	# Checkpoints: in order, but you may get there however you like.
	var cp = track.checkpoints[next_cp]
	if ship.position.distance_to(cp.pos) < track.hw[cp.idx] + 1.5:
		last_cp = next_cp
		ship.restore()
		Sfx.play("lap" if next_cp == 0 else "gate")
		if next_cp == 0:
			last_lap = lap_time
			if best_lap < 0.0 or lap_time < best_lap:
				best_lap = lap_time
			notify("LAP %d  %.2fs" % [lap, lap_time], Color(1.0, 0.95, 0.5))
			session.laps += 1
			if session.best < 0.0 or lap_time < session.best:
				session.best = lap_time
			_award_medals(lap_time)
			if race_laps > 0 and lap >= race_laps and race_over <= 0.0:
				_finish_race()
			lap += 1
			lap_time = 0.0
		next_cp = (next_cp + 1) % track.checkpoints.size()
	var pulse = 0.5 + 0.5 * sin(Time.get_ticks_msec() * 0.008)
	for k in track.checkpoints.size():
		var g = track.checkpoints[k]
		g.bar.emission_energy_multiplier = 0.4 + 0.6 * pulse if k == next_cp else 0.0
	# Boost pads.
	pad_cd -= delta
	for p in track.pads:
		if pad_cd <= 0.0 and not ship.airborne() and ship.position.distance_to(p.pos) < 2.6:
			var dir = p.dir if ship.vel.dot(p.dir) >= 0.0 else -p.dir
			ship.vel += dir * 16.0
			pad_cd = 0.6
			Sfx.play("warp", -6.0, 1.4)
			fx.burst(ship.position + Vector3(0, 0.3, 0), Color(0.3, 1.0, 0.6), 14, 6.0, 1.0, 0.08, 0.4, 2.0)
	# Ramps: hit the lip on the ground and you're thrown up; how far depends
	# on how fast you hit it.
	for r in track.ramps:
		var rel = ship.position - r.pos
		var along = rel.dot(r.dir)
		if absf(rel.dot(r.side)) > r.half or absf(along) > TrackScript.RAMP_LEN * 0.5 or ship.vy > 0.0:
			continue
		var h = TrackScript.RAMP_H * (along / TrackScript.RAMP_LEN + 0.5)
		if ship.alt > h + 0.1:
			continue
		ship.alt = h
		var fspeed = ship.vel.dot(r.dir)
		if along > TrackScript.RAMP_LEN * 0.5 - 0.5 and fspeed > 4.0:
			ship.launch(minf(3.5 + fspeed * 0.26, 8.5))
	# Mines.
	var t = Time.get_ticks_msec() * 0.001
	for m in track.mines:
		if m.timer > 0.0:
			m.timer -= delta
			if m.timer <= 0.0:
				m.node.visible = true
			continue
		m.node.scale = Vector3.ONE * (1.0 + 0.08 * sin(t * 6.0))
		m.node.rotation.y = t
		if ship.alt < 0.5 and ship.position.distance_to(m.pos) < ship.stats.radius + 0.7:
			m.node.visible = false
			m.timer = 6.0
			_explode(m.pos, 2.6, 2)
			var away = (ship.position - m.pos)
			away.y = 0.0
			ship.vel += away.normalized() * 10.0
			ship.take_hit(35.0)
			ship.stall = 0.35

func detonate_mine(m: Dictionary) -> void:
	m.node.visible = false
	m.timer = 6.0
	_explode(m.pos, 2.6, 2)
	if ship.position.distance_to(m.pos) < 2.5:
		ship.take_hit(20.0)

func _explode(p: Vector3, radius: float, tier: int) -> void:
	Sfx.play("small_boom" if radius < 2.0 else "boom", -2.0 if mode == "race" and p.distance_to(ship.position) > 25.0 else 0.0)
	terrain.blast(p, radius, tier)
	fx.burst(p + Vector3(0, 0.6, 0), Color(1.0, 0.55, 0.15), 40, 14.0, 1.2, 0.18, 0.6, 6.0)
	fx.burst(p + Vector3(0, 0.6, 0), Color(1.0, 0.9, 0.6), 20, 9.0, 1.5, 0.1, 0.35, 0.0)
	fx.burst(p + Vector3(0, 0.6, 0), Color(0.2, 0.2, 0.2), 16, 4.0, 0.0, 0.5, 1.0, -2.0)

func _drop_charge() -> void:
	if ship.charges <= 0:
		notify("NO CHARGES", Color(0.8, 0.8, 0.8))
		return
	ship.charges -= 1
	var node = Node3D.new()
	MeshKit.part(node, MeshKit.cyl(0.18, 0.18, 0.5, 6), MeshKit.mat(Color(0.75, 0.12, 0.1)), Vector3(0, 0.25, 0))
	var light = MeshKit.part(node, MeshKit.sphere(0.1, 6, 3), MeshKit.mat(Color(1, 0.2, 0.1), 4.0), Vector3(0, 0.55, 0))
	node.position = ship.position + ship.forward() * (ship.sockets.length * 0.5 + 0.8)
	add_child(node)
	live_charges.append({"node": node, "light": light, "t": 1.4})

func _update_charges(delta: float) -> void:
	for c in live_charges:
		c.t -= delta
		c.light.visible = fmod(c.t, 0.25) > 0.12
		if c.t <= 0.0:
			_explode(c.node.position, 3.4, 2)
			if ship.position.distance_to(c.node.position) < 3.5:
				ship.take_hit(12.0)
			c.node.queue_free()
	live_charges = live_charges.filter(func(c): return c.t > 0.0)

func _on_cell_destroyed(p: Vector3, k: int) -> void:
	fx.burst(p, terrain.kind_color(k), 6, 6.0, terrain.kind_glow(k), 0.24, 0.7)
	var ore = terrain.MATERIAL.get(k, "")
	if ore == "rock":
		# Rubble goes straight into the hold; ore has to be picked up.
		inventory["rock"] = inventory.get("rock", 0) + 1
		hud.flash("rock")
		return
	if ore == "":
		return
	for n in 1 + (randi() % 2):
		var c = terrain.kind_color(k)
		if not _pickup_mats.has(ore):
			_pickup_mats[ore] = MeshKit.mat(c, 0.5)
		var node = MeshKit.part(self, _pickup_mesh, _pickup_mats[ore], p, Vector3.ZERO, Vector3.ONE, false)
		pickups.append({"node": node, "pos": p, "vel": Vector3(randf_range(-3, 3), 5.0, randf_range(-3, 3)), "name": ore, "color": c, "age": 0.0})

# Ore chunks bob where they land until the ship's magnet range reaches them.
func _update_pickups(delta: float) -> void:
	var keep = []
	for pk in pickups:
		pk.age += delta
		var to = ship.position + Vector3(0, 0.7, 0) - pk.pos
		var d = to.length()
		if d < ship.stats.magnet and pk.age > 0.4:
			pk.vel = pk.vel.lerp(to.normalized() * (12.0 + 30.0 / maxf(d, 0.5)), minf(1.0, 6.0 * delta))
		else:
			pk.vel.y -= 14.0 * delta
			pk.vel *= 1.0 - 2.0 * delta
		pk.pos += pk.vel * delta
		if pk.pos.y < 0.5:
			pk.pos.y = 0.5
			pk.vel.y = absf(pk.vel.y) * 0.3
		pk.node.position = pk.pos + Vector3(0, 0.1 * sin(pk.age * 4.0), 0)
		pk.node.rotation = Vector3(pk.age * 2.0, pk.age * 3.0, 0)
		if d < ship.stats.radius + 0.5:
			inventory[pk.name] = inventory.get(pk.name, 0) + 1
			hud.flash(pk.name)
			Sfx.play("pickup", -4.0)
			pk.node.queue_free()
			continue
		if pk.age > 40.0:
			pk.node.queue_free()
			continue
		keep.append(pk)
	pickups = keep

func _update_camera(delta: float) -> void:
	var speed = ship.vel.length()
	var pitch = GARAGE_PITCH if garage else CAM_PITCH
	var target = ship.position + (Vector3.ZERO if garage else ship.vel * 0.3)
	cam_focus = cam_focus.lerp(target, minf(1.0, (8.0 if garage else 4.0) * delta))
	var dist = GARAGE_DIST if garage else get_meta("camdist", CAM_DIST) + speed * 0.35
	var off = Vector3(0, sin(deg_to_rad(pitch)), cos(deg_to_rad(pitch))) * dist
	cam.position = cam_focus + off + (Vector3(-4.2, 0.6, 0) if garage else Vector3.ZERO) + shake_offset()
	cam.rotation_degrees = Vector3(-pitch, 0, 0)
	if ortho and not garage:
		cam.projection = Camera3D.PROJECTION_ORTHOGONAL
		cam.size = 30.0 + speed * 0.25
	else:
		cam.projection = Camera3D.PROJECTION_PERSPECTIVE
		cam.fov = CAM_FOV
