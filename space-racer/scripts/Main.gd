func _ready():
	rng.seed = 1234
	_parse_args()
	if not _nosave():
		save_data = Save.read()
		inventory = save_data.get("inventory", {})
		if loadout.is_empty() and not has_meta("preset"):
			loadout = Save.clean_loadout(save_data.get("loadout", null))
		if loadout.is_empty():
			loadout = Parts.presets()[0]
		_migrate_owned()
	Controls.apply(save_data.get("keys", {}))
	add_child(Sfx.new())
	apply_sound()
	_build_world()
	terrain = TerrainScript.new()
	terrain.name = "Terrain"
	add_child(terrain)
	terrain.cell_destroyed.connect(_on_cell_destroyed)
	track = TrackScript.new()
	track.name = "Track"
	add_child(track)
	fx = FxScript.new()
	fx.name = "Fx"
	add_child(fx)
	ship = ShipScript.new()
	ship.name = "Ship"
	add_child(ship)
	ship.setup(terrain, track, fx, self)
	hud = HudScript.new()
	var layer = CanvasLayer.new()
	layer.layer = 2
	add_child(layer)
	layer.add_child(hud)
	hud.main = self
	var ed_layer = CanvasLayer.new()
	ed_layer.layer = 3
	add_child(ed_layer)
	editor = TrackEditorScript.new()
	ed_layer.add_child(editor)
	grid_garage = GridGarageScript.new()
	ed_layer.add_child(grid_garage)
	var menu_layer = CanvasLayer.new()
	menu_layer.layer = 4
	add_child(menu_layer)
	title_card = TitleCardScript.new()
	menu_layer.add_child(title_card)
	menu = GtMenuScript.new()
	menu_layer.add_child(menu)
	var top = CanvasLayer.new()
	top.layer = 5
	add_child(top)
	overlay = OverlayScript.new()
	top.add_child(overlay)
	_pickup_mesh = MeshKit.box(Vector3.ONE * 0.32)
	if loadout.is_empty():
		loadout = Parts.presets()[preset_index]
	ship.equip(loadout)
	_new_planet()
	if garage:
		garage = false
		open_garage()
	if has_meta("editor"):
		open_editor()
	if has_meta("menu"):
		open_menu()
	if has_meta("mining"):
		enter_mining()
	# Plain launch: the title screen, with the ship lapping behind it.
	if shot_path == "" and not has_meta("nosave") and not garage and not has_meta("editor") and not has_meta("menu") and not has_meta("mining"):
		show_title()

func _parse_args() -> void:
	for a in OS.get_cmdline_user_args():
		var kv = a.trim_prefix("--").split("=")
		match kv[0]:
			"preset":
				preset_index = int(kv[1]) % Parts.presets().size()
				set_meta("preset", true)
			"planet": planet_index = int(kv[1])
			"seed": track_seed = int(kv[1])
			"auto": set_meta("auto", true)
			"ortho": ortho = true
			"garage": garage = true
			"outline": set_meta("outline", true)
			"menu": set_meta("menu", true)
			"mining": set_meta("mining", true)
			"random": loadout = Parts.random_loadout(rng)
			"editor": set_meta("editor", true)
			"shot": shot_path = kv[1]
			"frames": shot_frames = int(kv[1])
			"camdist": set_meta("camdist", float(kv[1]))

func _build_world() -> void:
	var we = WorldEnvironment.new()
	env = Environment.new()
	env.background_mode = Environment.BG_COLOR
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_energy = 0.55
	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.tonemap_exposure = 1.05
	env.glow_enabled = false
	env.glow_intensity = 0.8
	env.glow_bloom = 0.04
	env.glow_hdr_threshold = 0.9
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SCREEN
	# Distance haze, PS2 style.
	env.fog_enabled = true
	env.fog_mode = Environment.FOG_MODE_DEPTH
	env.fog_depth_begin = 45.0
	env.fog_depth_end = 140.0
	env.fog_density = 1.0
	env.ssao_enabled = true
	env.ssao_radius = 1.6
	env.ssao_intensity = 1.6
	we.environment = env
	add_child(we)
	sun = DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-52, 145, 0)
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 110.0
	sun.light_energy = 0.9
	add_child(sun)
	cam = Camera3D.new()
	cam.fov = CAM_FOV
	cam.far = 500.0
	add_child(cam)
	var layer = CanvasLayer.new()
	layer.layer = 1
	add_child(layer)
	outline = ColorRect.new()
	outline.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	outline.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var m = ShaderMaterial.new()
	m.shader = OUTLINE_SHADER
	m.set_shader_parameter("threshold", 0.22)
	m.set_shader_parameter("outline_width", 1.0)
	outline.material = m
	outline.visible = has_meta("outline")
	layer.add_child(outline)
	_build_showroom()
	# Render 3D at half resolution and scale it up: chunkier, closer to the
	# era we're after. UI stays sharp.
	get_viewport().scaling_3d_mode = Viewport.SCALING_3D_MODE_BILINEAR
	get_viewport().scaling_3d_scale = 0.5

# Garage turntable, parked far off the map so nothing gets in the way.
func _build_showroom() -> void:
	var room = Node3D.new()
	room.position = SHOWROOM
	add_child(room)
	MeshKit.part(room, MeshKit.cyl(5.0, 5.2, 0.3, 40), MeshKit.mat(Color(0.07, 0.07, 0.09), 0.0, 0.35, 0.6), Vector3(0, -0.15, 0))
	MeshKit.part(room, MeshKit.torus(4.7, 4.85, 48, 4), MeshKit.mat(Color(0.75, 0.77, 0.8), 0.0, 0.3, 0.8), Vector3(0, 0.02, 0))
	for k in 24:
		var a = k * TAU / 24.0
		MeshKit.part(room, MeshKit.box(Vector3(0.05, 0.02, 0.6)), MeshKit.mat(Color(0.35, 0.37, 0.4)), Vector3(cos(a) * 4.2, 0.01, sin(a) * 4.2), Vector3(0, -rad_to_deg(a) + 90.0, 0))

func _new_planet() -> void:
	build_blueprint(TrackScript.auto_blueprint(track_seed, terrain), false)
	var p = terrain.planet
	env.background_color = p.sky
	env.fog_light_color = p.ground.lerp(p.sky, 0.5)
	env.ambient_light_color = p.ambient
	sun.light_color = p.sun
	notify(p.name.to_upper(), p.line, "planet")

# Lays a blueprint onto a fresh copy of the planet and restarts the race.
func build_blueprint(bp: Dictionary, announce: bool = true) -> void:
	terrain.generate(track_seed, planet_index)
	track.build(bp, terrain)
	terrain.rebuild()
	for pk in pickups:
		pk.node.queue_free()
	pickups.clear()
	best_lap = -1.0
	ship.set_process(not garage)
	_reset_race()
	if announce:
		notify("TRACK BUILT  -  %dm" % int(track.length), Color(0.5, 0.9, 1.0))
		save_game()

func open_editor() -> void:
	if garage:
		_set_garage(false)
	ship.set_process(false)
	editor.open(self)

func editor_closed() -> void:
	ship.set_process(not garage)

func _reset_race() -> void:
	session = {"laps": 0, "best": -1.0, "medals": [], "earned": {}}
	lap = 1
	lap_time = 0.0
	next_cp = 1
	last_cp = 0
	_respawn()
	ship.autopilot = has_meta("auto")
	cam_focus = ship.position

func _respawn() -> void:
	var cp = track.checkpoints[last_cp]
	ship.place(cp.pos - cp.dir * 3.0, atan2(cp.dir.x, cp.dir.z))
	ship.progress_idx = cp.idx
	ship.restore()

func _nosave() -> bool:
	return shot_path != "" or has_meta("nosave")

func save_game() -> void:
	if _nosave():
		return
	save_data.inventory = inventory
	save_data.loadout = loadout
	Save.write(save_data)

func _notification(what):
	if what == NOTIFICATION_WM_CLOSE_REQUEST:
		save_game()

# ---------------------------------------------------------------- owned parts

# How many of each part you own. A build can only use what you own.
func owned() -> Dictionary:
	if not save_data.has("owned"):
		save_data.owned = Parts.STARTER_KIT.duplicate()
	return save_data.owned

# First run with the parts economy: keep everything already built.
func _migrate_owned() -> void:
	if save_data.has("owned"):
		return
	var o = Parts.STARTER_KIT.duplicate()
	var builds = [loadout] + save_data.get("slots", []).filter(func(x): return x != null)
	for b in builds:
		var n = Parts.count_parts(b)
		for id in n:
			o[id] = maxi(o.get(id, 0), n[id])
	save_data.owned = o

# Parts this build needs beyond what you own.
func missing_parts(lo: Dictionary) -> Dictionary:
	var need = Parts.count_parts(lo)
	var o = owned()
	var miss = {}
	for id in need:
		if need[id] > o.get(id, 0):
			miss[id] = need[id] - o.get(id, 0)
	return miss

# Parts you own that the current build isn't using.
func spare_parts() -> Dictionary:
	var used = Parts.count_parts(loadout)
	var out = {}
	for id in owned():
		var n = owned()[id] - used.get(id, 0)
		if n > 0 and Parts.PARTS.has(id):
			out[id] = n
	return out

func can_afford(price: Dictionary, extra: Dictionary = {}) -> bool:
	for k in price:
		if inventory.get(k, 0) + extra.get(k, 0) < price[k]:
			return false
	return true

# ---------------------------------------------------------------- contracts

func contracts() -> Array:
	if not save_data.has("contracts"):
		save_data.contracts = []
	return save_data.contracts

# Each outpost keeps three offers; taking one puts up a fresh one.
func contract_offers(here: int) -> Array:
	if not save_data.has("offers"):
		save_data.offers = {}
	var key = str(here)
	var list = save_data.offers.get(key, [])
	var serial = save_data.get("offer_serial", 0)
	while list.size() < 3:
		var r = RandomNumberGenerator.new()
		r.seed = hash([here, serial, list.size(), track_seed])
		serial += 1
		list.append(Contracts.make(r, here, unlocks()))
	save_data.offer_serial = serial
	save_data.offers[key] = list
	return list

func accept_contract(here: int, k: int) -> bool:
	if contracts().size() >= Contracts.MAX_ACTIVE:
		notify("THREE CONTRACTS AT ONCE", Color(1.0, 0.4, 0.3))
		return false
	var offers = contract_offers(here)
	contracts().append(offers[k])
	offers.remove_at(k)
	Sfx.play("ui_select")
	save_game()
	return true

func abandon_contract(k: int) -> void:
	contracts().remove_at(k)
	save_game()

# Feed an event to every active contract; pay out the ones it finishes.
func contract_event(event: String, data: Dictionary) -> void:
	var done = []
	for c in contracts():
		if Contracts.on_event(c, event, data):
			done.append(c)
	for c in done:
		contracts().erase(c)
		for k in c.reward:
			inventory[k] = inventory.get(k, 0) + c.reward[k]
		if c.has("blueprint"):
			unlock(c.blueprint)
		notify("CONTRACT DONE  " + Contracts.reward_text(c).to_upper(), Color(0.95, 0.85, 0.3))
		Sfx.play("coins")
	if not done.is_empty():
		save_game()

# A planet's contract board: what you're on (pick one to abandon it), then
# the planet's three offers. Outposts and the race pause menu both open it.
func open_board(here: int, back: Callable) -> void:
	var again = func(): open_board(here, back)
	var rows = []
	var active = contracts()
	for i in active.size():
		var c = active[i]
		var k = i
		rows.append({"label": Contracts.title(c), "value": func(): return "ACTIVE  " + Contracts.progress(c),
			"action": func(): _confirm_abandon(k, again)})
	var offers = contract_offers(here)
	for i in offers.size():
		var c = offers[i]
		var k = i
		rows.append({"label": Contracts.title(c), "value": Contracts.reward_text(c),
			"action": func():
				if accept_contract(here, k):
					again.call()})
	rows.append({"label": "Back", "action": back})
	menu.show_menu(Contracts.PLANET_NAMES[here] + " CONTRACTS", rows, back, menu.title.ends_with("CONTRACTS"))

func _confirm_abandon(k: int, back: Callable) -> void:
	menu.show_menu("ABANDON?", [
		{"label": Contracts.title(contracts()[k]), "value": "no refund"},
		{"label": "Abandon", "action": func(): abandon_contract(k); back.call()},
		{"label": "Keep it", "action": back},
	], back)

# Blueprints and salvaged frames, by display name.
func unlocks() -> Array:
	return save_data.get("unlocks", [])

func unlock(name: String) -> void:
	var u = unlocks()
	if u.has(name):
		return
	u.append(name)
	save_data.unlocks = u
	notify("UNLOCKED  " + name.to_upper(), Color(0.75, 0.35, 1.0))
	save_game()

func track_key() -> String:
	return str(hash(var_to_str(track.blueprint)))

func medal_time(m: Dictionary) -> float:
	return track.length / m.speed

func medals_won() -> Array:
	return save_data.get("medals", {}).get(track_key(), [])

func _award_medals(t: float) -> void:
	var all = save_data.get("medals", {})
	var won = all.get(track_key(), [])
	for m in MEDALS:
		if t <= medal_time(m) and not won.has(m.name):
			won.append(m.name)
			var bits = []
			for k in m.reward:
				inventory[k] = inventory.get(k, 0) + m.reward[k]
				bits.append("+%d %s" % [m.reward[k], k])
				session.earned[k] = session.earned.get(k, 0) + m.reward[k]
			session.medals.append(m.name)
			notify("%s  %s" % [m.name.to_upper(), "  ".join(bits)], m.color)
			Sfx.play("coins")
	all[track_key()] = won
	save_data.medals = all
	save_game()

func equip(lo: Dictionary, announce: bool = true) -> void:
	loadout = lo
	ship.equip(lo)
	if announce:
		notify(lo.name.to_upper(), Color.WHITE)

# A short banner. Banners with a key replace any older one with that key
# (the planet name); all of them wait out a race countdown.
func notify(text: String, color: Color, key: String = "") -> void:
	if key != "":
		messages = messages.filter(func(m): return m.get("key", "") != key)
	messages.append({"text": text, "color": color, "t": 2.2, "key": key})
	if messages.size() > 3:
		messages.pop_front()

func menu_open() -> bool:
	return menu.visible or editor.visible or grid_garage.visible

func _unhandled_input(event):
	if shot_path != "":
		return
	if not (event is InputEventKey and event.pressed and not event.echo):
		return
	if editor.visible:
		if event.physical_keycode in [KEY_B, KEY_ESCAPE]:
			editor.close()
		return
	if title_on or countdown > 0.0:
		return
	if menu_open():
		return
	if mode == "mining":
		if event.physical_keycode == KEY_ESCAPE:
			mining.open_menu()
		return
	if event.is_action("garage"):
		open_garage()
	elif event.is_action("builder"):
		open_editor()
	elif event.is_action("charge"):
		_drop_charge()
	elif event.is_action("respawn"):
		_respawn()
	elif event.is_action("camera"):
		ortho = not ortho
	match event.physical_keycode:
		KEY_ESCAPE, KEY_ENTER:
			open_menu()
		KEY_P:
			ship.autopilot = not ship.autopilot
		KEY_F11:
			var full = DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN
			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED if full else DisplayServer.WINDOW_MODE_FULLSCREEN)

# ---------------------------------------------------------------- menus

func open_menu() -> void:
	ship.set_process(false)
	var practice = []
	if mode == "race" and race_laps == 0 and countdown <= 0.0:
		practice = [{"label": "End session", "value": func(): return "%d laps" % session.get("laps", 0), "action": show_session}]
	menu.show_menu("PAUSE", [
		{"label": "Resume", "action": close_menu}] + practice + [
		{"label": "Garage", "action": func(): close_menu(); open_garage()},
		{"label": "Pit shop", "action": func(): open_pit(open_menu)},
		{"label": "Contracts", "value": func(): return "%d / %d active" % [contracts().size(), Contracts.MAX_ACTIVE],
			"action": func(): open_board(planet_index % 4, open_menu)},
		{"label": "Track Builder", "action": func(): close_menu(); open_editor()},
		{"label": "Expedition", "action": func(): close_menu(); enter_mining()},
		{"label": "New Planet", "action": func(): close_menu(); _next_planet()},
		{"label": "Camera", "value": func(): return "Ortho" if ortho else "Perspective",
			"action": func(): ortho = not ortho, "left": func(): ortho = not ortho, "right": func(): ortho = not ortho},
		{"label": "Outlines", "value": func(): return "On" if outline.visible else "Off",
			"action": func(): outline.visible = not outline.visible, "left": func(): outline.visible = not outline.visible, "right": func(): outline.visible = not outline.visible},
		{"label": "Render", "value": func(): return "Low-res" if get_viewport().scaling_3d_scale < 1.0 else "Full",
			"action": _toggle_res, "left": _toggle_res, "right": _toggle_res},
		{"label": "Controls", "action": func(): open_controls(open_menu)},
		{"label": "Sound", "action": func(): open_sound(open_menu)},
		{"label": "Main menu", "action": func(): close_menu(); show_title()},
		{"label": "Quit", "action": func(): save_game(); get_tree().quit()},
	], close_menu)

# ---------------------------------------------------------------- pit shop

# The track's pit lane sells stock parts (no mechanics' specials, those are
# at the outposts) and buys spares back, all through the bank.
func open_pit(back: Callable) -> void:
	var rows = []
	for id in Parts.shop_stock(""):
		if Parts.is_locked(Parts.PARTS[id], unlocks()):
			continue
		var pid = id
		var pr = Parts.price(pid)
		rows.append({"label": Parts.PARTS[pid].name,
			"value": func(): return "%d owned   %s" % [owned().get(pid, 0), _price_text(pr)],
			"action": func(): _pit_buy(pid, back)})
	rows.append({"label": "Sell parts", "value": func(): return "%d spare" % spare_parts().values().reduce(func(a, b): return a + b, 0),
		"action": func(): _pit_sell_menu(back)})
	rows.append({"label": "Back", "action": back})
	menu.show_menu("PIT SHOP", rows, back, menu.title == "PIT SHOP")
	menu.wallet = func(): return {"bank": inventory}

func _price_text(price: Dictionary) -> String:
	var bits = []
	for k in price:
		bits.append("%d %s" % [price[k], k])
	return "  ".join(bits)

func _pit_buy(id: String, back: Callable) -> void:
	var pr = Parts.price(id)
	if not can_afford(pr):
		notify("NOT ENOUGH", Color(1.0, 0.3, 0.3))
		return
	for k in pr:
		inventory[k] -= pr[k]
	owned()[id] = owned().get(id, 0) + 1
	notify("BOUGHT  " + Parts.PARTS[id].name.to_upper(), Color.WHITE)
	Sfx.play("coins")
	save_game()
	open_pit(back)

func _pit_sell_menu(back: Callable) -> void:
	var rows = []
	var spares = spare_parts()
	for id in spares:
		var pid = id
		rows.append({"label": Parts.PARTS[pid].name, "value": "%d spare   +%s" % [spares[pid], _price_text(MiningScript.sell_price(pid))],
			"action": func(): _pit_sell(pid, back)})
	var up = func(): open_pit(back)
	rows.append({"label": "Back", "action": up})
	menu.show_menu("SELL", rows, up, menu.title == "SELL")
	menu.wallet = func(): return {"bank": inventory}

func _pit_sell(id: String, back: Callable) -> void:
	if spare_parts().get(id, 0) <= 0:
		return
	var o = owned()
	o[id] -= 1
	if o[id] <= 0:
		o.erase(id)
	var pay = MiningScript.sell_price(id)
	for k in pay:
		inventory[k] = inventory.get(k, 0) + pay[k]
	notify("SOLD  " + Parts.PARTS[id].name.to_upper(), Color.WHITE)
	Sfx.play("coins")
	save_game()
	_pit_sell_menu(back)

# ---------------------------------------------------------------- sound

const SOUND_ROWS = [["master", "Master"], ["fx", "Effects"], ["loops", "Engines"]]

func sound_levels() -> Dictionary:
	if not save_data.has("sound"):
		save_data.sound = {"master": 8, "fx": 10, "loops": 10}
	return save_data.sound

func apply_sound() -> void:
	var lv = sound_levels()
	AudioServer.set_bus_volume_db(0, Sfx._db(lv.master / 10.0))
	Sfx.fx_gain = lv.fx / 10.0
	Sfx.loop_gain = lv.loops / 10.0

func _nudge_sound(key: String, d: int) -> void:
	var lv = sound_levels()
	lv[key] = clampi(lv[key] + d, 0, 10)
	apply_sound()
	Sfx.play("ui_move" if key != "loops" else "tick")
	save_game()

# Master / effects / engines, 0 to 10, left and right to change.
func open_sound(back: Callable) -> void:
	var rows = []
	for r in SOUND_ROWS:
		var key = r[0]
		rows.append({"label": r[1],
			"value": func():
				var n = sound_levels()[key]
				return "■".repeat(n) + "□".repeat(10 - n) + "  %d" % n,
			"left": func(): _nudge_sound(key, -1), "right": func(): _nudge_sound(key, 1)})
	rows.append({"label": "Back", "action": back})
	menu.show_menu("SOUND", rows, back, menu.title == "SOUND")

# Every action and its key. Pick a row, press a key to rebind it.
func open_controls(back: Callable) -> void:
	var rows = []
	for a in Controls.ACTIONS:
		var id = a[0]
		rows.append({"label": a[1],
			"value": func(): return "press a key" if rebinding == id else Controls.key_name(id, save_data.get("keys", {})),
			"action": func(): _rebind(id, back)})
	rows.append({"label": "Reset to defaults", "action": func(): _reset_keys(back)})
	menu.show_menu("CONTROLS", rows, back, menu.title == "CONTROLS")

func _reset_keys(back: Callable) -> void:
	save_data.keys = {}
	Controls.apply({})
	save_game()
	open_controls(back)

func _rebind(id: String, back: Callable) -> void:
	rebinding = id
	menu.capture = func(key: int):
		rebinding = ""
		if key != KEY_ESCAPE:
			var keys = save_data.get("keys", {})
			keys[id] = key
			save_data.keys = keys
			Controls.apply(keys)
			save_game()
		open_controls(back)

