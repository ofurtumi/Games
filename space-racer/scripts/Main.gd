extends Node3D

# Boots the sandbox: one planet, one autogenerated track, one ship. Owns the
# camera, the race (checkpoints, laps), pickups, mines, pads and charges.
#
# Command line (after `--`): --preset=N --planet=N --seed=N --auto --ortho
# --garage --outline --editor --random --shot=/path.png --frames=N
# (screenshot then quit)

const Parts = preload("res://scripts/Parts.gd")
const MeshKit = preload("res://scripts/MeshKit.gd")
const TerrainScript = preload("res://scripts/Terrain.gd")
const TrackScript = preload("res://scripts/Track.gd")
const FxScript = preload("res://scripts/Fx.gd")
const ShipScript = preload("res://scripts/Ship.gd")
const HudScript = preload("res://scripts/Hud.gd")
const TrackEditorScript = preload("res://scripts/TrackEditor.gd")
const GridGarageScript = preload("res://scripts/GridGarage.gd")
const GtMenuScript = preload("res://scripts/GtMenu.gd")
const Save = preload("res://scripts/Save.gd")
const MiningScript = preload("res://scripts/Mining.gd")
const Controls = preload("res://scripts/Controls.gd")

# Lap times that earn materials, as average speed over the lap (m/s). Each
# medal pays out once per track.
const MEDALS = [
	{"name": "gold", "speed": 26.0, "color": Color(1.0, 0.82, 0.25), "reward": {"crystal": 5, "metal": 6}},
	{"name": "silver", "speed": 21.0, "color": Color(0.8, 0.83, 0.88), "reward": {"metal": 6, "crystal": 2}},
	{"name": "bronze", "speed": 16.0, "color": Color(0.8, 0.5, 0.28), "reward": {"rock": 15, "metal": 3}},
]
const OUTLINE_SHADER = preload("res://assets/shaders/screen_outline.gdshader")

const CAM_PITCH = 58.0
const CAM_DIST = 34.0
const CAM_FOV = 34.0
const GARAGE_PITCH = 32.0
const GARAGE_DIST = 11.5
const SHOWROOM = Vector3(0, 0, -1500)

var terrain
var track
var fx
var ship
var hud
var editor
var grid_garage
var menu
var cam: Camera3D
var env: Environment
var sun: DirectionalLight3D
var outline: ColorRect

var rng = RandomNumberGenerator.new()
var loadout: Dictionary
var preset_index = 0
var planet_index = 0
var track_seed = 11
var ortho = false
var garage = false


var lap = 1
var lap_time = 0.0
var last_lap = -1.0
var best_lap = -1.0
var next_cp = 1
var last_cp = 0
var inventory = {}
var pickups = []
var live_charges = []
var messages = []
var pad_cd = 0.0
var cam_focus = Vector3.ZERO
var _saved_pose = []
var _pickup_mesh: Mesh
var _pickup_mats = {}

var save_data = {}
var mode = "race"   # or "mining"
var mining = null
var rebinding = ""
var rivals = []   # other racers (Node3D); none yet, but the minimap draws them
var shot_path = ""
var shot_frames = 120
var _frame = 0

func _ready():
	rng.seed = 1234
	_parse_args()
	if not _nosave():
		save_data = Save.read()
		inventory = save_data.get("inventory", {})
		if loadout.is_empty() and not has_meta("preset"):
			loadout = Save.clean_loadout(save_data.get("loadout", null))
	Controls.apply(save_data.get("keys", {}))
	_build_world()
	terrain = TerrainScript.new()
	terrain.name = "Terrain"
	add_child(terrain)
	terrain.cell_destroyed.connect(_on_cell_destroyed)
	track = TrackScript.new()
	track.name = "Track"
	add_child(track)
	fx = FxScript.new()
	fx.name = "Fx"
	add_child(fx)
	ship = ShipScript.new()
	ship.name = "Ship"
	add_child(ship)
	ship.setup(terrain, track, fx, self)
	hud = HudScript.new()
	var layer = CanvasLayer.new()
	layer.layer = 2
	add_child(layer)
	layer.add_child(hud)
	hud.main = self
	var ed_layer = CanvasLayer.new()
	ed_layer.layer = 3
	add_child(ed_layer)
	editor = TrackEditorScript.new()
	ed_layer.add_child(editor)
	grid_garage = GridGarageScript.new()
	ed_layer.add_child(grid_garage)
	var menu_layer = CanvasLayer.new()
	menu_layer.layer = 4
	add_child(menu_layer)
	menu = GtMenuScript.new()
	menu_layer.add_child(menu)
	_pickup_mesh = MeshKit.box(Vector3.ONE * 0.32)
	if loadout.is_empty():
		loadout = Parts.presets()[preset_index]
	ship.equip(loadout)
	_new_planet()
	if garage:
		garage = false
		open_garage()
	if has_meta("editor"):
		open_editor()
	if has_meta("menu"):
		open_menu()
	if has_meta("mining"):
		enter_mining()

func _parse_args() -> void:
	for a in OS.get_cmdline_user_args():
		var kv = a.trim_prefix("--").split("=")
		match kv[0]:
			"preset":
				preset_index = int(kv[1]) % Parts.presets().size()
				set_meta("preset", true)
			"planet": planet_index = int(kv[1])
			"seed": track_seed = int(kv[1])
			"auto": set_meta("auto", true)
			"ortho": ortho = true
			"garage": garage = true
			"outline": set_meta("outline", true)
			"menu": set_meta("menu", true)
			"mining": set_meta("mining", true)
			"random": loadout = Parts.random_loadout(rng)
			"editor": set_meta("editor", true)
			"shot": shot_path = kv[1]
			"frames": shot_frames = int(kv[1])
			"camdist": set_meta("camdist", float(kv[1]))

func _build_world() -> void:
	var we = WorldEnvironment.new()
	env = Environment.new()
	env.background_mode = Environment.BG_COLOR
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_energy = 0.55
	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.tonemap_exposure = 1.05
	env.glow_enabled = false
	env.glow_intensity = 0.8
	env.glow_bloom = 0.04
	env.glow_hdr_threshold = 0.9
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SCREEN
	# Distance haze, PS2 style.
	env.fog_enabled = true
	env.fog_mode = Environment.FOG_MODE_DEPTH
	env.fog_depth_begin = 45.0
	env.fog_depth_end = 140.0
	env.fog_density = 1.0
	env.ssao_enabled = true
	env.ssao_radius = 1.6
	env.ssao_intensity = 1.6
	we.environment = env
	add_child(we)
	sun = DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-52, 145, 0)
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 110.0
	sun.light_energy = 0.9
	add_child(sun)
	cam = Camera3D.new()
	cam.fov = CAM_FOV
	cam.far = 500.0
	add_child(cam)
	var layer = CanvasLayer.new()
	layer.layer = 1
	add_child(layer)
	outline = ColorRect.new()
	outline.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	outline.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var m = ShaderMaterial.new()
	m.shader = OUTLINE_SHADER
	m.set_shader_parameter("threshold", 0.22)
	m.set_shader_parameter("outline_width", 1.0)
	outline.material = m
	outline.visible = has_meta("outline")
	layer.add_child(outline)
	_build_showroom()
	# Render 3D at half resolution and scale it up: chunkier, closer to the
	# era we're after. UI stays sharp.
	get_viewport().scaling_3d_mode = Viewport.SCALING_3D_MODE_BILINEAR
	get_viewport().scaling_3d_scale = 0.5

# Garage turntable, parked far off the map so nothing gets in the way.
func _build_showroom() -> void:
	var room = Node3D.new()
	room.position = SHOWROOM
	add_child(room)
	MeshKit.part(room, MeshKit.cyl(5.0, 5.2, 0.3, 40), MeshKit.mat(Color(0.07, 0.07, 0.09), 0.0, 0.35, 0.6), Vector3(0, -0.15, 0))
	MeshKit.part(room, MeshKit.torus(4.7, 4.85, 48, 4), MeshKit.mat(Color(0.75, 0.77, 0.8), 0.0, 0.3, 0.8), Vector3(0, 0.02, 0))
	for k in 24:
		var a = k * TAU / 24.0
		MeshKit.part(room, MeshKit.box(Vector3(0.05, 0.02, 0.6)), MeshKit.mat(Color(0.35, 0.37, 0.4)), Vector3(cos(a) * 4.2, 0.01, sin(a) * 4.2), Vector3(0, -rad_to_deg(a) + 90.0, 0))

func _new_planet() -> void:
	build_blueprint(TrackScript.auto_blueprint(track_seed, terrain), false)
	var p = terrain.planet
	env.background_color = p.sky
	env.fog_light_color = p.ground.lerp(p.sky, 0.5)
	env.ambient_light_color = p.ambient
	sun.light_color = p.sun
	notify(p.name.to_upper(), p.line)

# Lays a blueprint onto a fresh copy of the planet and restarts the race.
func build_blueprint(bp: Dictionary, announce: bool = true) -> void:
	terrain.generate(track_seed, planet_index)
	track.build(bp, terrain)
	terrain.rebuild()
	for pk in pickups:
		pk.node.queue_free()
	pickups.clear()
	best_lap = -1.0
	ship.set_process(not garage)
	_reset_race()
	if announce:
		notify("TRACK BUILT  -  %dm" % int(track.length), Color(0.5, 0.9, 1.0))
		save_game()

func open_editor() -> void:
	if garage:
		_set_garage(false)
	ship.set_process(false)
	editor.open(self)

func editor_closed() -> void:
	ship.set_process(not garage)

func _reset_race() -> void:
	lap = 1
	lap_time = 0.0
	next_cp = 1
	last_cp = 0
	_respawn()
	ship.autopilot = has_meta("auto")
	cam_focus = ship.position

func _respawn() -> void:
	var cp = track.checkpoints[last_cp]
	ship.place(cp.pos - cp.dir * 3.0, atan2(cp.dir.x, cp.dir.z))
	ship.progress_idx = cp.idx
	ship.restore()

func _nosave() -> bool:
	return shot_path != "" or has_meta("nosave")

func save_game() -> void:
	if _nosave():
		return
	save_data.inventory = inventory
	save_data.loadout = loadout
	Save.write(save_data)

func _notification(what):
	if what == NOTIFICATION_WM_CLOSE_REQUEST:
		save_game()

func track_key() -> String:
	return str(hash(var_to_str(track.blueprint)))

func medal_time(m: Dictionary) -> float:
	return track.length / m.speed

func medals_won() -> Array:
	return save_data.get("medals", {}).get(track_key(), [])

func _award_medals(t: float) -> void:
	var all = save_data.get("medals", {})
	var won = all.get(track_key(), [])
	for m in MEDALS:
		if t <= medal_time(m) and not won.has(m.name):
			won.append(m.name)
			var bits = []
			for k in m.reward:
				inventory[k] = inventory.get(k, 0) + m.reward[k]
				bits.append("+%d %s" % [m.reward[k], k])
			notify("%s  %s" % [m.name.to_upper(), "  ".join(bits)], m.color)
	all[track_key()] = won
	save_data.medals = all
	save_game()

func equip(lo: Dictionary, announce: bool = true) -> void:
	loadout = lo
	ship.equip(lo)
	if announce:
		notify(lo.name.to_upper(), Color.WHITE)

func notify(text: String, color: Color) -> void:
	messages.append({"text": text, "color": color, "t": 2.2})
	if messages.size() > 3:
		messages.pop_front()

func menu_open() -> bool:
	return menu.visible or editor.visible or grid_garage.visible

func _unhandled_input(event):
	if shot_path != "":
		return
	if not (event is InputEventKey and event.pressed and not event.echo):
		return
	if editor.visible:
		if event.physical_keycode in [KEY_B, KEY_ESCAPE]:
			editor.close()
		return
	if menu_open():
		return
	if mode == "mining":
		if event.physical_keycode == KEY_ESCAPE:
			mining.open_menu()
		return
	if event.is_action("garage"):
		open_garage()
	elif event.is_action("builder"):
		open_editor()
	elif event.is_action("charge"):
		_drop_charge()
	elif event.is_action("respawn"):
		_respawn()
	elif event.is_action("camera"):
		ortho = not ortho
	match event.physical_keycode:
		KEY_ESCAPE, KEY_ENTER:
			open_menu()
		KEY_P:
			ship.autopilot = not ship.autopilot
		KEY_F11:
			var full = DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN
			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED if full else DisplayServer.WINDOW_MODE_FULLSCREEN)

# ---------------------------------------------------------------- menus

func open_menu() -> void:
	ship.set_process(false)
	menu.show_menu("PAUSE", [
		{"label": "Resume", "action": close_menu},
		{"label": "Garage", "action": func(): close_menu(); open_garage()},
		{"label": "Track Builder", "action": func(): close_menu(); open_editor()},
		{"label": "Expedition", "action": func(): close_menu(); enter_mining()},
		{"label": "New Planet", "action": func(): close_menu(); _next_planet()},
		{"label": "Camera", "value": func(): return "Ortho" if ortho else "Perspective",
			"action": func(): ortho = not ortho, "left": func(): ortho = not ortho, "right": func(): ortho = not ortho},
		{"label": "Outlines", "value": func(): return "On" if outline.visible else "Off",
			"action": func(): outline.visible = not outline.visible, "left": func(): outline.visible = not outline.visible, "right": func(): outline.visible = not outline.visible},
		{"label": "Render", "value": func(): return "Low-res" if get_viewport().scaling_3d_scale < 1.0 else "Full",
			"action": _toggle_res, "left": _toggle_res, "right": _toggle_res},
		{"label": "Controls", "action": func(): open_controls(open_menu)},
		{"label": "Quit", "action": func(): save_game(); get_tree().quit()},
	], close_menu)

# Every action and its key. Pick a row, press a key to rebind it.
func open_controls(back: Callable) -> void:
	var rows = []
	for a in Controls.ACTIONS:
		var id = a[0]
		rows.append({"label": a[1],
			"value": func(): return "press a key" if rebinding == id else Controls.key_name(id, save_data.get("keys", {})),
			"action": func(): _rebind(id, back)})
	rows.append({"label": "Reset to defaults", "action": func(): _reset_keys(back)})
	menu.show_menu("CONTROLS", rows, back, menu.title == "CONTROLS")

func _reset_keys(back: Callable) -> void:
	save_data.keys = {}
	Controls.apply({})
	save_game()
	open_controls(back)

func _rebind(id: String, back: Callable) -> void:
	rebinding = id
	menu.capture = func(key: int):
		rebinding = ""
		if key != KEY_ESCAPE:
			var keys = save_data.get("keys", {})
			keys[id] = key
			save_data.keys = keys
			Controls.apply(keys)
			save_game()
		open_controls(back)

func close_menu() -> void:
	menu.hide_menu()
	ship.set_process(not garage)

func _toggle_res() -> void:
	var vp = get_viewport()
	vp.scaling_3d_scale = 1.0 if vp.scaling_3d_scale < 1.0 else 0.5

func _next_planet() -> void:
	planet_index += 1
	track_seed = rng.randi() % 100000
	_new_planet()

func open_garage() -> void:
	if mode == "mining":
		ship.visible = true
		cam.current = true
	_set_garage(true)
	grid_garage.open(self)

func garage_closed() -> void:
	_set_garage(false)
	save_game()
	if mode == "mining":
		ship.visible = false
		ship.set_process(false)
		mining.garage_closed()

# ---------------------------------------------------------------- modes

func enter_mining() -> void:
	if mode == "mining":
		return
	mode = "mining"
	for n in [terrain, track, ship, hud]:
		n.visible = false
	ship.set_process(false)
	for pk in pickups:
		pk.node.queue_free()
	pickups.clear()
	mining = MiningScript.new()
	mining.name = "Mining"
	add_child(mining)
	mining.setup(self)

func leave_mining() -> void:
	if mode != "mining":
		return
	mining.leave()
	mining = null
	mode = "race"
	for n in [terrain, track, ship, hud]:
		n.visible = true
	cam.current = true
	ship.set_process(true)
	_respawn()
	save_game()

func _set_garage(on: bool) -> void:
	if on == garage:
		return
	garage = on
	ship.set_process(not on)
	if on:
		_saved_pose = [ship.position, ship.heading]
		ship.place(SHOWROOM, PI * 0.8)
	else:
		ship.model.rotation = Vector3.ZERO
		ship.rig.shield.visible = true
		if _saved_pose.size() > 0:
			ship.place(_saved_pose[0], _saved_pose[1])
	cam_focus = ship.position

func _process(delta):
	delta = minf(delta, 1.0 / 30.0)
	if mode == "mining" and not garage:
		for m in messages:
			m.t -= delta
		messages = messages.filter(func(m): return m.t > 0.0)
		return
	if garage:
		ship.model.rotate_y(delta * 0.6)
		ship.model.position.y = ship.HOVER + sin(Time.get_ticks_msec() * 0.002) * 0.05
		ship.rig.shield.visible = false
		for f in ship.rig.flames:
			f.scale = Vector3(1, 1, 0.3 + randf() * 0.1)
		for sp in ship.rig.spinners:
			sp[0].rotate_object_local(sp[1], sp[2] * delta)
	else:
		lap_time += delta
		_race(delta)
	_update_pickups(delta)
	_update_charges(delta)
	_update_camera(delta)
	for m in messages:
		m.t -= delta
	messages = messages.filter(func(m): return m.t > 0.0)
	hud.queue_redraw()
	if shot_path != "":
		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS, true)
		_frame += 1
		if _frame == shot_frames:
			var img = get_viewport().get_texture().get_image()
			img.save_png(shot_path)
			print("saved ", shot_path, " garage=", garage, " ship=", ship.position, " cam=", cam.position)
			get_tree().quit()

func _race(delta: float) -> void:
	ship.progress_idx = track.nearest(ship.position, ship.progress_idx)
	# Checkpoints: in order, but you may get there however you like.
	var cp = track.checkpoints[next_cp]
	if ship.position.distance_to(cp.pos) < track.hw[cp.idx] + 1.5:
		last_cp = next_cp
		ship.restore()
		if next_cp == 0:
			last_lap = lap_time
			if best_lap < 0.0 or lap_time < best_lap:
				best_lap = lap_time
			notify("LAP %d  %.2fs" % [lap, lap_time], Color(1.0, 0.95, 0.5))
			_award_medals(lap_time)
			lap += 1
			lap_time = 0.0
		next_cp = (next_cp + 1) % track.checkpoints.size()
	var pulse = 0.5 + 0.5 * sin(Time.get_ticks_msec() * 0.008)
	for k in track.checkpoints.size():
		var g = track.checkpoints[k]
		g.bar.emission_energy_multiplier = 0.4 + 0.6 * pulse if k == next_cp else 0.0
	# Boost pads.
	pad_cd -= delta
	for p in track.pads:
		if pad_cd <= 0.0 and not ship.airborne() and ship.position.distance_to(p.pos) < 2.6:
			var dir = p.dir if ship.vel.dot(p.dir) >= 0.0 else -p.dir
			ship.vel += dir * 16.0
			pad_cd = 0.6
			fx.burst(ship.position + Vector3(0, 0.3, 0), Color(0.3, 1.0, 0.6), 14, 6.0, 1.0, 0.08, 0.4, 2.0)
	# Ramps: hit the lip on the ground and you're thrown up; how far depends
	# on how fast you hit it.
	for r in track.ramps:
		var rel = ship.position - r.pos
		var along = rel.dot(r.dir)
		if absf(rel.dot(r.side)) > r.half or absf(along) > TrackScript.RAMP_LEN * 0.5 or ship.vy > 0.0:
			continue
		var h = TrackScript.RAMP_H * (along / TrackScript.RAMP_LEN + 0.5)
		if ship.alt > h + 0.1:
			continue
		ship.alt = h
		var fspeed = ship.vel.dot(r.dir)
		if along > TrackScript.RAMP_LEN * 0.5 - 0.5 and fspeed > 4.0:
			ship.launch(minf(3.5 + fspeed * 0.26, 8.5))
	# Mines.
	var t = Time.get_ticks_msec() * 0.001
	for m in track.mines:
		if m.timer > 0.0:
			m.timer -= delta
			if m.timer <= 0.0:
				m.node.visible = true
			continue
		m.node.scale = Vector3.ONE * (1.0 + 0.08 * sin(t * 6.0))
		m.node.rotation.y = t
		if ship.alt < 0.5 and ship.position.distance_to(m.pos) < ship.stats.radius + 0.7:
			m.node.visible = false
			m.timer = 6.0
			_explode(m.pos, 2.6, 2)
			var away = (ship.position - m.pos)
			away.y = 0.0
			ship.vel += away.normalized() * 10.0
			ship.take_hit(35.0)
			ship.stall = 0.35

func detonate_mine(m: Dictionary) -> void:
	m.node.visible = false
	m.timer = 6.0
	_explode(m.pos, 2.6, 2)
	if ship.position.distance_to(m.pos) < 2.5:
		ship.take_hit(20.0)

func _explode(p: Vector3, radius: float, tier: int) -> void:
	terrain.blast(p, radius, tier)
	fx.burst(p + Vector3(0, 0.6, 0), Color(1.0, 0.55, 0.15), 40, 14.0, 1.2, 0.18, 0.6, 6.0)
	fx.burst(p + Vector3(0, 0.6, 0), Color(1.0, 0.9, 0.6), 20, 9.0, 1.5, 0.1, 0.35, 0.0)
	fx.burst(p + Vector3(0, 0.6, 0), Color(0.2, 0.2, 0.2), 16, 4.0, 0.0, 0.5, 1.0, -2.0)

func _drop_charge() -> void:
	if ship.charges <= 0:
		notify("NO CHARGES", Color(0.8, 0.8, 0.8))
		return
	ship.charges -= 1
	var node = Node3D.new()
	MeshKit.part(node, MeshKit.cyl(0.18, 0.18, 0.5, 6), MeshKit.mat(Color(0.75, 0.12, 0.1)), Vector3(0, 0.25, 0))
	var light = MeshKit.part(node, MeshKit.sphere(0.1, 6, 3), MeshKit.mat(Color(1, 0.2, 0.1), 4.0), Vector3(0, 0.55, 0))
	node.position = ship.position + ship.forward() * (ship.sockets.length * 0.5 + 0.8)
	add_child(node)
	live_charges.append({"node": node, "light": light, "t": 1.4})

func _update_charges(delta: float) -> void:
	for c in live_charges:
		c.t -= delta
		c.light.visible = fmod(c.t, 0.25) > 0.12
		if c.t <= 0.0:
			_explode(c.node.position, 3.4, 2)
			if ship.position.distance_to(c.node.position) < 3.5:
				ship.take_hit(12.0)
			c.node.queue_free()
	live_charges = live_charges.filter(func(c): return c.t > 0.0)

func _on_cell_destroyed(p: Vector3, k: int) -> void:
	fx.burst(p, terrain.kind_color(k), 6, 6.0, terrain.kind_glow(k), 0.24, 0.7)
	var ore = terrain.MATERIAL.get(k, "")
	if ore == "rock":
		# Rubble goes straight into the hold; ore has to be picked up.
		inventory["rock"] = inventory.get("rock", 0) + 1
		hud.flash("rock")
		return
	if ore == "":
		return
	for n in 1 + (randi() % 2):
		var c = terrain.kind_color(k)
		if not _pickup_mats.has(ore):
			_pickup_mats[ore] = MeshKit.mat(c, 0.5)
		var node = MeshKit.part(self, _pickup_mesh, _pickup_mats[ore], p, Vector3.ZERO, Vector3.ONE, false)
		pickups.append({"node": node, "pos": p, "vel": Vector3(randf_range(-3, 3), 5.0, randf_range(-3, 3)), "name": ore, "color": c, "age": 0.0})

# Ore chunks bob where they land until the ship's magnet range reaches them.
func _update_pickups(delta: float) -> void:
	var keep = []
	for pk in pickups:
		pk.age += delta
		var to = ship.position + Vector3(0, 0.7, 0) - pk.pos
		var d = to.length()
		if d < ship.stats.magnet and pk.age > 0.4:
			pk.vel = pk.vel.lerp(to.normalized() * (12.0 + 30.0 / maxf(d, 0.5)), minf(1.0, 6.0 * delta))
		else:
			pk.vel.y -= 14.0 * delta
			pk.vel *= 1.0 - 2.0 * delta
		pk.pos += pk.vel * delta
		if pk.pos.y < 0.5:
			pk.pos.y = 0.5
			pk.vel.y = absf(pk.vel.y) * 0.3
		pk.node.position = pk.pos + Vector3(0, 0.1 * sin(pk.age * 4.0), 0)
		pk.node.rotation = Vector3(pk.age * 2.0, pk.age * 3.0, 0)
		if d < ship.stats.radius + 0.5:
			inventory[pk.name] = inventory.get(pk.name, 0) + 1
			hud.flash(pk.name)
			pk.node.queue_free()
			continue
		if pk.age > 40.0:
			pk.node.queue_free()
			continue
		keep.append(pk)
	pickups = keep

func _update_camera(delta: float) -> void:
	var speed = ship.vel.length()
	var pitch = GARAGE_PITCH if garage else CAM_PITCH
	var target = ship.position + (Vector3.ZERO if garage else ship.vel * 0.3)
	cam_focus = cam_focus.lerp(target, minf(1.0, (8.0 if garage else 4.0) * delta))
	var dist = GARAGE_DIST if garage else get_meta("camdist", CAM_DIST) + speed * 0.35
	var off = Vector3(0, sin(deg_to_rad(pitch)), cos(deg_to_rad(pitch))) * dist
	cam.position = cam_focus + off + (Vector3(-4.2, 0.6, 0) if garage else Vector3.ZERO)
	cam.rotation_degrees = Vector3(-pitch, 0, 0)
	if ortho and not garage:
		cam.projection = Camera3D.PROJECTION_ORTHOGONAL
		cam.size = 30.0 + speed * 0.25
	else:
		cam.projection = Camera3D.PROJECTION_PERSPECTIVE
		cam.fov = CAM_FOV
